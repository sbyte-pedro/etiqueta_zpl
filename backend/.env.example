# Backend environment variables. Copy to `.env` and fill in real values:
#   cp backend/.env.example backend/.env
#
# .env is gitignored — never commit real secrets.

# PostgreSQL connection string. REQUIRED — the server refuses to start without it.
DATABASE_URL=postgresql://postgres:root@localhost:5432/etiqueta_zpl

# Secret for signing/verifying JWTs. REQUIRED in production.
# Generate a strong one with:  openssl rand -hex 32
JWT_SECRET=dev-secret

# Port for the Express server. Optional (default: 3001).
PORT=3001

# Allowed CORS origin for the frontend. Optional (default: http://localhost:5173).
FRONTEND_URL=http://localhost:5173
