meta {
  name: Preview (PNG)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/preview
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "zpl": "^XA\n^PW800\n^LL1200\n^CF0,60\n^FO50,50^FDSample Label^FS\n^FO50,200^BCN,120,Y,N,N^FD12345678^FS\n^XZ",
    "labelWidth": 800,
    "labelHeight": 1200
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  const ct = res.headers["content-type"] || "";
  if (!ct.includes("image/png")) {
    throw new Error("Expected image/png, got: " + ct);
  }
}
