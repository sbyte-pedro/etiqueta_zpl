meta {
  name: Generate ZPL
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/generate-zpl
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "labelWidth": 800,
    "labelHeight": 1200,
    "elements": [
      {
        "id": "1",
        "type": "text",
        "x": 50,
        "y": 50,
        "width": 300,
        "height": 40,
        "value": "Hello World",
        "fontSize": 40,
        "fontName": "0"
      },
      {
        "id": "2",
        "type": "text",
        "x": 50,
        "y": 150,
        "width": 300,
        "height": 40,
        "fontSize": 30,
        "fontName": "0",
        "dynamic": true,
        "variableName": "company"
      },
      {
        "id": "3",
        "type": "barcode128",
        "x": 50,
        "y": 250,
        "width": 400,
        "height": 120,
        "value": "12345678"
      },
      {
        "id": "4",
        "type": "qrcode",
        "x": 50,
        "y": 420,
        "width": 120,
        "height": 120,
        "value": "https://example.com"
      }
    ]
  }
}

assert {
  res.status: eq 200
  res.body.zpl: isString
}

script:post-response {
  const zpl = res.body.zpl || "";
  if (!zpl.includes("^XA") || !zpl.includes("^XZ")) {
    throw new Error("ZPL missing ^XA/^XZ wrapper");
  }
  if (!zpl.includes("{{company}}")) {
    throw new Error("Dynamic variable placeholder not emitted");
  }
}
