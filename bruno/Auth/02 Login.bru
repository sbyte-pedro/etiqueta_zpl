meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

assert {
  res.status: eq 200
  res.body.token: isString
}

script:post-response {
  // Save the JWT so every protected request can use {{token}}.
  if (res.body && res.body.token) {
    bru.setEnvVar("token", res.body.token);
  }
}
