meta {
  name: Login - Bad Password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "wrong-password"
  }
}

assert {
  res.status: eq 401
  res.body.error: eq Invalid username or password
}
