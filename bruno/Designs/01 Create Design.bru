meta {
  name: Create Design
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/designs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Bruno Test Design {{$timestamp}}",
    "zpl": "^XA\n^PW800\n^LL1200\n^FO50,50^A0N,40,40^FDv1^FS\n^XZ",
    "elements": [
      { "id": "1", "type": "text", "x": 50, "y": 50, "width": 200, "height": 40, "value": "v1", "fontSize": 40, "fontName": "0" }
    ],
    "labelWidth": 800,
    "labelHeight": 1200
  }
}

assert {
  res.status: eq 201
  res.body.designId: isNumber
  res.body.versionId: isNumber
}

script:post-response {
  // Save the new design id for the subsequent design requests.
  if (res.body && res.body.designId) {
    bru.setEnvVar("designId", String(res.body.designId));
  }
}
